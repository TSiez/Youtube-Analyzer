# --- YouTube Data API ---
# API key from your Google Cloud project (APIs & Services > Credentials > API Keys).
# Used for read-only YouTube queries (no OAuth needed).
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Groq (LLM for transcript summarization) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Google Sheets ---
# Leave blank on first run — the pipeline will create the sheet and print the new ID
# so you can paste it here. On subsequent runs it appends to the same sheet.
SPREADSHEET_ID=

# --- Google Slides ---
# Same pattern: leave blank on first run, paste the ID after the deck is created.
PRESENTATION_ID=

# --- Gmail (delivery) ---
# Where the weekly report email gets sent
RECIPIENT_EMAIL=you@example.com
# The Gmail account doing the sending (must match the Google account you authorize on first run)
SENDER_EMAIL=you@gmail.com

# --- Inputs (optional defaults; the dashboard / CLI flags override these) ---
# Comma-separated channel handles (with @) or channel IDs
YT_CHANNELS=@mkbhd,@verge
# Comma-separated keywords to search
YT_KEYWORDS=ai,productivity

# How far back to fetch in days (default 7 for a weekly report)
LOOKBACK_DAYS=7
# Max results per channel/keyword
MAX_RESULTS=10
